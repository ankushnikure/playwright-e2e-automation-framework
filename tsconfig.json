{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "types": ["node", "@playwright/test"],
    "paths": {
            "@fixtures/*": ["./src/fixtures/*"],
            "@pages/*": ["./src/pages/*"],
            "@routes/*": ["./src/routes/*"],
            "@test-data/*": ["./src/test-data/*"],
            "@utils/*": ["./src/utils/*"],
        },
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ]
}